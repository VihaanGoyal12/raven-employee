{
  "name": "raven-employee-directory",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.16.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node test/run_suite.mjs"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "sally": {
              "password": "pass",
              "roles": [
                "SalesUser"
              ]
            },
            "max": {
              "password": "pass",
              "roles": [
                "SalesUser",
                "SalesManager"
              ]
            },
            "alex": {
              "password": "pass",
              "roles": [
                "FulfillmentManager"
              ]
            },
            "admin": {
              "password": "pass",
              "roles": [
                "SalesUser",
                "SalesManager",
                "FulfillmentManager"
              ]
            }
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}
