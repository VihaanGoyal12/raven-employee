{
  "name": "raven-employee-directory",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.16.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-employees": "cds watch --open raven.employeedirectory.employees/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy raven-employee-directory --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "sally": {
              "password": "pass",
              "roles": [
                "SalesUser"
              ]
            },
            "max": {
              "password": "pass",
              "roles": [
                "SalesUser",
                "SalesManager"
              ]
            },
            "alex": {
              "password": "pass",
              "roles": [
                "FulfillmentManager"
              ]
            },
            "admin": {
              "password": "pass",
              "roles": [
                "SalesUser",
                "SalesManager",
                "FulfillmentManager"
              ]
            }
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employees"
  ]
}
