{
  "format_version": 1,
  "imports": [
    {
      "target_table": "RAVEN_PROCUREMENT_PURCHASEORDERS",
      "source_data": {
        "data_type": "CSV",
        "file_name": "raven.procurement-PurchaseOrders.csv",
        "has_header": true,
        "type_config": {
          "delimiter": ","
        }
      },
      "import_settings": {
        "import_columns": [
          "ID",
          "PONUMBER",
          "SUPPLIER_ID",
          "ORDERDATE",
          "STATUS",
          "TOTALAMOUNT"
        ],
        "include_filter": [
          {
            "ID": "b1111111-1111-4111-8111-111111111111"
          },
          {
            "ID": "b2222222-2222-4222-8222-222222222222"
          }
        ]
      },
      "column_mappings": {
        "ID": "ID",
        "PONUMBER": "poNumber",
        "SUPPLIER_ID": "supplier_ID",
        "ORDERDATE": "orderDate",
        "STATUS": "status",
        "TOTALAMOUNT": "totalAmount"
      }
    }
  ]
}
