{
  "format_version": 1,
  "imports": [
    {
      "target_table": "RAVEN_PROCUREMENT_PURCHASEORDERITEMS",
      "source_data": {
        "data_type": "CSV",
        "file_name": "raven.procurement-PurchaseOrderItems.csv",
        "has_header": true,
        "type_config": {
          "delimiter": ","
        }
      },
      "import_settings": {
        "import_columns": [
          "ID",
          "PARENT_ID",
          "PRODUCTNAME",
          "QUANTITY",
          "UNITPRICE",
          "LINETOTAL"
        ],
        "include_filter": [
          {"ID": "c1111111-1111-4111-8111-111111111111"},
          {"ID": "c2222222-2222-4222-8222-222222222222"},
          {"ID": "c3333333-3333-4333-8333-333333333333"},
          {"ID": "c4444444-4444-4444-8444-444444444444"}
        ]
      },
      "column_mappings": {
        "ID": "ID",
        "PARENT_ID": "parent_ID",
        "PRODUCTNAME": "productName",
        "QUANTITY": "quantity",
        "UNITPRICE": "unitPrice",
        "LINETOTAL": "lineTotal"
      }
    }
  ]
}
