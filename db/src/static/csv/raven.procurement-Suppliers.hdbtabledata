{
  "format_version": 1,
  "imports": [
    {
      "target_table": "RAVEN_PROCUREMENT_SUPPLIERS",
      "source_data": {
        "data_type": "CSV",
        "file_name": "raven.procurement-Suppliers.csv",
        "has_header": true,
        "type_config": {
          "delimiter": ","
        }
      },
      "import_settings": {
        "import_columns": [
          "ID",
          "NAME",
          "CREDITLIMIT"
        ],
        "include_filter": [
          {
            "ID": "a1111111-1111-4111-8111-111111111111"
          },
          {
            "ID": "a2222222-2222-4222-8222-222222222222"
          },
          {
            "ID": "a3333333-3333-4333-8333-333333333333"
          }
        ]
      },
      "column_mappings": {
        "ID": "ID",
        "NAME": "name",
        "CREDITLIMIT": "creditLimit"
      }
    }
  ]
}