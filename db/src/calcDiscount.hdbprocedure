PROCEDURE "CALC_DISCOUNT" (
    IN customerType NVARCHAR(20),
    IN grossAmount DECIMAL(15,2),
    OUT discountPercent DECIMAL(5,2)
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
    IF :customerType = 'Premium' AND :grossAmount > 10000 THEN
        discountPercent := 15.0;
    ELSEIF :customerType = 'Premium' AND :grossAmount > 5000 THEN
        discountPercent := 10.0;
    ELSEIF :customerType = 'Regular' AND :grossAmount > 5000 THEN
        discountPercent := 5.0;
    ELSE
        discountPercent := 0.0;
    END IF;
END;
