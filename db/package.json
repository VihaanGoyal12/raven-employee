{
  "name": "deploy",
  "dependencies": {
    "hdb": "^2.0.0",
    "@sap/hdi-deploy": "^5"
  },
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "start": "node node_modules/@sap/hdi-deploy/deploy.js --use-hdb --parameter com.sap.hana.di.table/try_fast_table_migration=true --undeploy \"src/gen/data/raven.procurement-PurchaseOrderItems.hdbtabledata\" --path-parameter \"src/gen/data/raven.procurement-PurchaseOrderItems.hdbtabledata:skip_data_deletion=true\" --undeploy \"src/gen/data/raven.procurement-PurchaseOrders.hdbtabledata\" --path-parameter \"src/gen/data/raven.procurement-PurchaseOrders.hdbtabledata:skip_data_deletion=true\" --undeploy \"src/gen/data/raven.procurement-Suppliers.hdbtabledata\" --path-parameter \"src/gen/data/raven.procurement-Suppliers.hdbtabledata:skip_data_deletion=true\""
  }
}
