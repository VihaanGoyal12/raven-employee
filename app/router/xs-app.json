{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "^/odata/v4/sales/(.*)$",
      "target": "/odata/v4/sales/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/odata/v4/fulfillment/(.*)$",
      "target": "/odata/v4/fulfillment/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/salesorders/(.*)$",
      "target": "$1",
      "localDir": "resources/salesorders",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/fulfillmentcockpit/(.*)$",
      "target": "$1",
      "localDir": "resources/fulfillmentcockpit",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/fulfillmentsummary/(.*)$",
      "target": "$1",
      "localDir": "resources/fulfillmentsummary",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/employees/(.*)$",
      "target": "$1",
      "localDir": "resources/employees",
      "authenticationType": "none"
    },
    {
      "source": "^/purchaseorders/(.*)$",
      "target": "$1",
      "localDir": "resources/purchaseorders",
      "authenticationType": "none"
    },
    {
      "source": "^/inventory/(.*)$",
      "target": "$1",
      "localDir": "resources/inventory",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}
