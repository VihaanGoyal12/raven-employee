<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="addWarehouseDialog"
        title="{i18n>dialogAddWarehouseTitle}"
        contentWidth="28rem"
        initialFocus="inpWarehouseName">
        <form:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false">

            <Label text="{i18n>warehouseName}" required="true"/>
            <Input
                id="inpWarehouseName"
                value="{view>/newWarehouse/name}"
                placeholder="e.g. Mumbai Warehouse"/>

            <Label text="{i18n>location}" required="true"/>
            <Input
                id="inpWarehouseLocation"
                value="{view>/newWarehouse/location}"
                placeholder="e.g. Mumbai"/>
        </form:SimpleForm>

        <beginButton>
            <Button
                id="btnSaveNewWarehouse"
                type="Emphasized"
                text="{i18n>save}"
                press=".onSaveNewWarehouse"
                enabled="{= !!${view>/newWarehouse/name} &amp;&amp; !!${view>/newWarehouse/location} }"/>
        </beginButton>

        <endButton>
            <Button
                id="btnCancelNewWarehouse"
                text="{i18n>cancel}"
                press=".onCancelAddWarehouse"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>

