<mvc:View
    controllerName="orderapproval.salesorders.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <f:DynamicPage id="detailPage" headerExpanded="true">

        <!-- Object Page Header — matches PDF Pages 4 and 9 -->
        <f:title>
            <f:DynamicPageTitle>
                <f:navigationActions>
                    <OverflowToolbarButton
                        icon="sap-icon://nav-back"
                        tooltip="Back to List"
                        press=".onNavBack" />
                </f:navigationActions>
                <f:heading>
                    <ObjectStatus
                        id="pageStatus"
                        text="{status}"
                        state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}"
                        icon="{parts: [{path: 'status'}], formatter: '.formatStatusIcon'}"
                        inverted="true" />
                </f:heading>
                <f:expandedHeading>
                    <VBox>
                        <Title
                            text="{parts: [{path: 'orderNumber'}], formatter: '.formatOrderTitle'}"
                            level="H2" />
                        <ObjectStatus
                            text="{status}"
                            state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}"
                            icon="{parts: [{path: 'status'}], formatter: '.formatStatusIcon'}" />
                    </VBox>
                </f:expandedHeading>
                <f:actions>
                    <Button
                        id="btnSendToHoD"
                        text="Send to HoD for Approval"
                        type="Emphasized"
                        press=".onSendToHoD"
                        visible="{parts: [{path: 'status'}], formatter: '.canSendToHoD'}" />
                    <Button
                        text="Edit"
                        type="Transparent"
                        press=".onEdit"
                        visible="{parts: [{path: 'status'}], formatter: '.canEdit'}" />
                    <Button
                        text="Delete"
                        type="Transparent"
                        press=".onDelete" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- KPI Header — Gross / Discount / Net (PDF Pages 4 and 9) -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox alignItems="Start" wrap="Wrap" class="sapUiSmallMarginTop">
                    <VBox class="sapUiLargeMarginEnd">
                        <Label text="Order Number" />
                        <Title text="{orderNumber}" level="H4" />
                    </VBox>
                    <VBox class="sapUiLargeMarginEnd">
                        <Label text="Customer" />
                        <Title text="{customer/name}" level="H4" />
                    </VBox>
                    <VBox class="sapUiLargeMarginEnd">
                        <Label text="Customer Type" />
                        <ObjectStatus
                            text="{customer/customerType}"
                            state="{parts: [{path: 'customer/customerType'}], formatter: '.formatTypeState'}" />
                    </VBox>
                    <VBox class="sapUiLargeMarginEnd">
                        <Label text="Order Date" />
                        <Title text="{orderDate}" level="H4" />
                    </VBox>
                </HBox>
                <HBox alignItems="Start" wrap="Wrap" class="sapUiSmallMarginTop sapUiLargeMarginBottom">
                    <!-- KPI Boxes matching PDF -->
                    <FlexBox direction="Column" class="sapUiLargeMarginEnd" alignItems="Center">
                        <ObjectNumber
                            number="{parts: [{path: 'grossAmount'}], formatter: '.formatAmount'}"
                            unit="INR"
                            emphasized="true"
                            class="sapUiTinyMarginBottom" />
                        <Label text="Gross Amount" />
                    </FlexBox>
                    <FlexBox direction="Column" class="sapUiLargeMarginEnd" alignItems="Center">
                        <ObjectNumber
                            number="{parts: [{path: 'discountPercent'}], formatter: '.formatPercent'}"
                            unit="%"
                            emphasized="true"
                            class="sapUiTinyMarginBottom" />
                        <Label text="Discount (HANA Procedure)" />
                    </FlexBox>
                    <FlexBox direction="Column" class="sapUiLargeMarginEnd" alignItems="Center">
                        <ObjectNumber
                            number="{parts: [{path: 'netAmount'}], formatter: '.formatAmount'}"
                            unit="INR"
                            emphasized="true"
                            state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}"
                            class="sapUiTinyMarginBottom" />
                        <Label text="Net Amount" />
                    </FlexBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox class="sapUiSmallMargin">

                <!-- Section tabs -->
                <IconTabBar id="detailTabBar" selectedKey="general" class="sapUiSmallMarginBottom">
                    <items>
                        <IconTabFilter key="general" text="General Information" icon="sap-icon://detail-view" />
                        <IconTabFilter key="items" text="Items" icon="sap-icon://list" />
                        <IconTabFilter key="workflow" text="Approval History" icon="sap-icon://process" />
                    </items>
                </IconTabBar>

                <!-- General Information Section — matches PDF Pages 4-5 -->
                <Panel id="generalPanel" headerText="Order Details" class="sapUiResponsiveMargin" expandable="false">
                    <form:SimpleForm
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="4" emptySpanL="4" emptySpanM="4"
                        columnsXL="2" columnsL="2" columnsM="1"
                        singleContainerFullSize="false">
                        <form:content>
                            <Label text="Order Number" />
                            <Text text="{orderNumber}" />

                            <Label text="Customer Name" />
                            <Text text="{customer/name}" />

                            <Label text="Customer Type" />
                            <ObjectStatus
                                text="{customer/customerType}"
                                state="{parts: [{path: 'customer/customerType'}], formatter: '.formatTypeState'}" />

                            <Label text="Order Date" />
                            <Text text="{orderDate}" />

                            <Label text="Gross Amount (INR)" />
                            <ObjectNumber
                                number="{parts: [{path: 'grossAmount'}], formatter: '.formatAmount'}"
                                unit="INR" />

                            <Label text="Discount %" />
                            <ObjectNumber
                                number="{parts: [{path: 'discountPercent'}], formatter: '.formatPercent'}"
                                unit="%" />

                            <Label text="Net Amount (INR)" />
                            <ObjectNumber
                                number="{parts: [{path: 'netAmount'}], formatter: '.formatAmount'}"
                                unit="INR" />

                            <Label text="Requested By" />
                            <Text text="{requestedBy}" />

                            <Label text="Workflow Status" />
                            <ObjectStatus
                                text="{status}"
                                state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}"
                                icon="{parts: [{path: 'status'}], formatter: '.formatStatusIcon'}" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <!-- Approval Comments Section — visible when workflow started -->
                <Panel
                    id="commentsPanel"
                    headerText="Approval Comments"
                    class="sapUiResponsiveMargin"
                    expandable="true"
                    visible="{parts: [{path: 'hodComment'}, {path: 'financeComment'}], formatter: '.hasComments'}">
                    <form:SimpleForm
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="4" emptySpanL="4" emptySpanM="4"
                        columnsXL="1" columnsL="1" columnsM="1">
                        <form:content>
                            <Label text="HoD Comment" />
                            <Text text="{hodComment}" />

                            <Label text="Finance Department Comment" />
                            <Text text="{financeComment}" />

                            <Label text="Workflow Instance ID" />
                            <Text text="{workflowInstanceId}" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <!-- Items Table — matches PDF Page 5 -->
                <Panel id="itemsPanel" headerText="Order Items" class="sapUiResponsiveMargin" expandable="false">
                    <Table
                        id="itemsTable"
                        items="{items}">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Items" level="H4" />
                                <ToolbarSpacer />
                                <Button
                                    text="Add Item"
                                    type="Transparent"
                                    press=".onAddItem"
                                    icon="sap-icon://add"
                                    visible="{parts: [{path: 'status'}], formatter: '.canEdit'}" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text text="Product" /></Column>
                            <Column hAlign="End"><Text text="Quantity" /></Column>
                            <Column hAlign="End"><Text text="Unit Price (INR)" /></Column>
                            <Column hAlign="End"><Text text="Line Total (INR)" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{product}" />
                                    <ObjectNumber number="{quantity}" />
                                    <ObjectNumber
                                        number="{parts: [{path: 'unitPrice'}], formatter: '.formatAmount'}"
                                        unit="INR" />
                                    <ObjectNumber
                                        number="{parts: [{path: 'quantity'}, {path: 'unitPrice'}], formatter: '.formatLineTotal'}"
                                        unit="INR" />
                                </cells>
                            </ColumnListItem>
                        </items>
                        <noData>
                            <Text text="No items added." />
                        </noData>
                    </Table>
                </Panel>

                <!-- Approval History / Workflow Section -->
                <Panel id="workflowPanel" headerText="Approval Workflow History" class="sapUiResponsiveMargin" expandable="true">
                    <VBox class="sapUiSmallMargin">
                        <Timeline id="approvalTimeline">
                            <TimelineItem
                                title="Order Created"
                                dateTime="{orderDate}"
                                icon="sap-icon://create"
                                userName="{requestedBy}"
                                text="Order submitted for approval." />
                        </Timeline>
                        <Text
                            text="Full workflow history is tracked in SAP Build Process Automation."
                            class="sapUiSmallMarginTop sapUiSmallText" />
                    </VBox>
                </Panel>

            </VBox>
        </f:content>

    </f:DynamicPage>

</mvc:View>
