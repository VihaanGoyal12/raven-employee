<mvc:View
    controllerName="orderapproval.salesorders.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="detailPage"
        title="{parts: [{path: 'orderNumber'}], formatter: '.formatOrderTitle'}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <headerContent>
            <ObjectStatus
                text="{status}"
                state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}"
                icon="{parts: [{path: 'status'}], formatter: '.formatStatusIcon'}"
                class="sapUiSmallMarginEnd" />
            <Button
                text="Send to HoD for Approval"
                type="Emphasized"
                press=".onSendToHoD"
                visible="{parts: [{path: 'status'}], formatter: '.canSendToHoD'}" />
            <Button
                text="Approve"
                type="Accept"
                press=".onApprove"
                visible="{parts: [{path: 'status'}], formatter: '.canEdit'}" />
        </headerContent>

        <content>
            <VBox class="sapUiResponsiveMargin">

                <!-- Header KPI Summary Card -->
                <Panel headerText="Financial Overview" class="sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceAround" class="sapUiSmallMargin">
                        <VBox alignItems="Center">
                            <Label text="Gross Amount" />
                            <ObjectNumber
                                number="{parts: [{path: 'grossAmount'}], formatter: '.formatAmount'}"
                                unit="USD"
                                emphasized="true" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Label text="Discount" />
                            <ObjectNumber
                                number="{parts: [{path: 'discountPercent'}], formatter: '.formatPercent'}"
                                unit="%"
                                state="Information" />
                        </VBox>
                        <VBox alignItems="Center">
                            <Label text="Net Amount" />
                            <ObjectNumber
                                number="{parts: [{path: 'netAmount'}], formatter: '.formatAmount'}"
                                unit="USD"
                                emphasized="true"
                                state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}" />
                        </VBox>
                    </HBox>
                </Panel>

                <!-- Order & Customer Details -->
                <Panel headerText="Order &amp; Customer Information" class="sapUiSmallMarginBottom" expandable="true" expanded="true">
                    <form:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                        <form:content>
                            <core:Title text="Order Details" />
                            <Label text="Order Number" />
                            <Text text="{orderNumber}" />
                            <Label text="Order Date" />
                            <Text text="{parts: [{path: 'orderDate'}], formatter: '.formatDate'}" />
                            <Label text="Requested By" />
                            <Text text="{requestedBy}" />
                            <Label text="Workflow Status" />
                            <ObjectStatus
                                text="{status}"
                                state="{parts: [{path: 'status'}], formatter: '.formatStatusState'}"
                                icon="{parts: [{path: 'status'}], formatter: '.formatStatusIcon'}" />

                            <core:Title text="Customer Details" />
                            <Label text="Customer Name" />
                            <Text text="{customer/name}" />
                            <Label text="Customer Type" />
                            <ObjectStatus
                                text="{customer/customerType}"
                                state="{parts: [{path: 'customer/customerType'}], formatter: '.formatTypeState'}" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <!-- Line Items Table -->
                <Panel headerText="Order Items" class="sapUiSmallMarginBottom" expandable="true" expanded="true">
                    <Table items="{items}" noDataText="No line items available.">
                        <columns>
                            <Column><Text text="Product" /></Column>
                            <Column hAlign="End"><Text text="Quantity" /></Column>
                            <Column hAlign="End"><Text text="Unit Price (USD)" /></Column>
                            <Column hAlign="End"><Text text="Total (USD)" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{product}" />
                                    <Text text="{quantity}" />
                                    <ObjectNumber
                                        number="{parts: [{path: 'unitPrice'}], formatter: '.formatAmount'}"
                                        unit="USD" />
                                    <ObjectNumber
                                        number="{parts: [{path: 'quantity'}, {path: 'unitPrice'}], formatter: '.formatLineTotal'}"
                                        unit="USD" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- Comments Section -->
                <Panel
                    headerText="Approval Comments"
                    expandable="true"
                    expanded="true"
                    visible="{parts: [{path: 'hodComment'}, {path: 'financeComment'}], formatter: '.hasComments'}">
                    <form:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                        <form:content>
                            <Label text="HoD Comments" visible="{= !!${hodComment} }" />
                            <Text text="{hodComment}" visible="{= !!${hodComment} }" />
                            <Label text="Finance Comments" visible="{= !!${financeComment} }" />
                            <Text text="{financeComment}" visible="{= !!${financeComment} }" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
