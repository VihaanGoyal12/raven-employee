
{
  "xsappname": "raven-employee-directory-f1de4b2dtrial-dev",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://oauth.pstmn.io/v1/callback",
      "https://f1de4b2dtrial-dev-raven-employee-directory-router.cfapps.ap21.hana.ondemand.com/**",
      "http://localhost:5000/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.SalesUser",
      "description": "Create and view sales orders"
    },
    {
      "name": "$XSAPPNAME.SalesManager",
      "description": "Approve sales orders"
    },
    {
      "name": "$XSAPPNAME.FulfillmentManager",
      "description": "Reserve stock and dispatch orders"
    }
  ],
  "role-templates": [
    {
      "name": "SalesUserRole",
      "scope-references": [
        "$XSAPPNAME.SalesUser"
      ]
    },
    {
      "name": "SalesManagerRole",
      "scope-references": [
        "$XSAPPNAME.SalesUser",
        "$XSAPPNAME.SalesManager"
      ]
    },
    {
      "name": "FulfillmentManagerRole",
      "scope-references": [
        "$XSAPPNAME.FulfillmentManager"
      ]
    }
  ]
}
